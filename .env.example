DATABASE_URL=postgres://postgres:postgres@localhost:5432/posthouse
POSTPILOT_SESSION_SECRET=replace-with-a-long-random-string
POSTPILOT_FRONTEND_ORIGINS=http://localhost:5000
POSTPILOT_API_ORIGIN=http://127.0.0.1:8000
POSTPILOT_DEBUG_DEMO=true
# Microsoft Entra SSO is opt-in. Do not set ENABLED=true until the backend
# token-validation and tenant identity-linking stages are deployed.
# These values are configuration, not Azure client secrets. Restrict the
# directory tenant IDs and use the exact SPA redirect URI registered in Entra.
POSTPILOT_MICROSOFT_SSO_ENABLED=false
POSTPILOT_MICROSOFT_SSO_SPA_CLIENT_ID=your-spa-application-client-id
POSTPILOT_MICROSOFT_SSO_AUTHORITY=https://login.microsoftonline.com/organizations
POSTPILOT_MICROSOFT_SSO_API_AUDIENCE=your-fastapi-application-client-id
POSTPILOT_MICROSOFT_SSO_ALLOWED_TENANT_IDS=your-entra-directory-tenant-id
POSTPILOT_MICROSOFT_SSO_REDIRECT_URIS=http://localhost:5000/sign-in
POSTPILOT_MICROSOFT_SSO_REQUIRED_SCOPE=api://your-fastapi-application-client-id/access_as_user

# NEXT_PUBLIC values are intentionally public and embedded in the Next.js
# browser build. They must match the API settings above exactly.
NEXT_PUBLIC_POSTPILOT_MSAL_ENABLED=false
NEXT_PUBLIC_POSTPILOT_MSAL_CLIENT_ID=your-spa-application-client-id
NEXT_PUBLIC_POSTPILOT_MSAL_AUTHORITY=https://login.microsoftonline.com/your-entra-directory-tenant-id
NEXT_PUBLIC_POSTPILOT_MSAL_API_SCOPE=api://your-fastapi-application-client-id/access_as_user
NEXT_PUBLIC_POSTPILOT_MSAL_REDIRECT_URI=http://localhost:5000/sign-in
RESEND_API_KEY=
EMAIL_FROM="PostPilot <signin@example.com>"

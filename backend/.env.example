# Convert the existing PostgreSQL URL to SQLAlchemy format automatically, or
# set it directly as postgresql+asyncpg://user:password@host/database.
POSTPILOT_DATABASE_URL=postgresql://postpilot:postpilot@localhost:5432/postpilot
POSTPILOT_SESSION_SECRET=replace-with-at-least-32-random-characters
POSTPILOT_FRONTEND_ORIGINS=http://localhost:5000,http://localhost:3000
POSTPILOT_ENVIRONMENT=development
POSTPILOT_COOKIE_SECURE=false
POSTPILOT_DEBUG_DEMO=false
POSTPILOT_DEMO_SWITCHER_USER_ID=user_maya
# Microsoft Entra SSO stays disabled until token validation and tenant identity
# linking are configured. These are public Entra identifiers, not client
# secrets. The matching browser values are documented in the root example.
POSTPILOT_MICROSOFT_SSO_ENABLED=false
POSTPILOT_MICROSOFT_SSO_SPA_CLIENT_ID=your-spa-application-client-id
POSTPILOT_MICROSOFT_SSO_AUTHORITY=https://login.microsoftonline.com/organizations
POSTPILOT_MICROSOFT_SSO_API_AUDIENCE=your-fastapi-application-client-id
POSTPILOT_MICROSOFT_SSO_ALLOWED_TENANT_IDS=your-entra-directory-tenant-id
POSTPILOT_MICROSOFT_SSO_REDIRECT_URIS=http://localhost:5000/sign-in
POSTPILOT_MICROSOFT_SSO_REQUIRED_SCOPE=api://your-fastapi-application-client-id/access_as_user

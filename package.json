{
  "name": "posthouse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:all": "pnpm test:e2e",
    "test:e2e": "playwright test && playwright test --config playwright.auth.config.ts",
    "test:ui": "playwright test",
    "test:auth": "playwright test --config playwright.auth.config.ts",
    "test:backend": "cd backend && pytest",
    "test:shows": "playwright test tests/ui/shows.spec.ts tests/ui/shows-detail.spec.ts",
    "test:bookings": "playwright test tests/ui/bookings.spec.ts tests/ui/my-time.spec.ts",
    "test:approvals": "playwright test tests/ui/approvals.spec.ts",
    "test:deliveries": "playwright test tests/ui/deliveries.spec.ts tests/ui/delivery-profiles.spec.ts",
    "test:delivery-lifecycle": "cd backend && pytest tests/test_delivery_lifecycle.py tests/test_delivery_register_state.py"
  },
  "dependencies": {
    "@heroui/react": "^3.2.2",
    "@heroui/theme": "^2.4.26",
    "@hookform/resolvers": "^5.4.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.24.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.81.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "postgres": "^3.4.9",
    "typescript": "^5"
  }
}

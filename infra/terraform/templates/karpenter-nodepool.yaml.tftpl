apiVersion: karpenter.k8s.aws/v1
kind: EC2NodeClass
metadata:
  name: postpilot-spot
spec:
  # Re-use the EKS managed node role, which is already authorised to join this
  # cluster and is restricted to EKS worker, VPC CNI, and ECR-read policies.
  role: ${node_role_name}
  amiSelectorTerms:
    - alias: al2023@latest
  subnetSelectorTerms:
    - tags:
        karpenter.sh/discovery: ${cluster_name}
  securityGroupSelectorTerms:
    - tags:
        karpenter.sh/discovery: ${cluster_name}
  tags:
    Project: postpilot
    ManagedBy: karpenter
---
apiVersion: karpenter.sh/v1
kind: NodePool
metadata:
  name: postpilot-spot-small
spec:
  template:
    spec:
      expireAfter: 720h
      requirements:
        - key: kubernetes.io/arch
          operator: In
          values: ["amd64"]
        - key: kubernetes.io/os
          operator: In
          values: ["linux"]
        - key: karpenter.sh/capacity-type
          operator: In
          values: ["spot"]
        - key: node.kubernetes.io/instance-type
          operator: In
          values:
%{ for instance_type in instance_types ~}
            - "${instance_type}"
%{ endfor ~}
      nodeClassRef:
        group: karpenter.k8s.aws
        kind: EC2NodeClass
        name: postpilot-spot
  limits:
    cpu: "${max_cpu}"
    memory: ${max_memory}
  disruption:
    consolidationPolicy: WhenEmptyOrUnderutilized
    consolidateAfter: 5m

# Copy to .env and replace these values before exposing the service.
POSTGRES_DB=postpilot
POSTGRES_USER=postpilot
POSTGRES_PASSWORD=replace-with-a-unique-postgres-password
POSTPILOT_SESSION_SECRET=replace-with-a-long-random-session-secret
POSTPILOT_DEBUG_DEMO=false

# Add the browser origin used by this deployment. Keep localhost for local use.
POSTPILOT_FRONTEND_ORIGINS=http://localhost:5000
